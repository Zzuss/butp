# 生产环境配置文件
# 复制此文件为 .env.local 并填入实际值

# 基础配置
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://butp.tech

# 成绩导入：浏览器直连 ECS
NEXT_PUBLIC_GRADE_IMPORT_URL=https://import.butp.tech
# 与 ECS /opt/butp-worker/.env 中的 IMPORT_TOKEN_SECRET 完全相同
# 可使用 `openssl rand -base64 48` 生成
IMPORT_TOKEN_SECRET=replace-with-at-least-32-random-characters

# Session密钥 (生产环境必须使用强密钥)
SESSION_SECRET_KEY=your-super-secret-session-key-at-least-32-chars-long-for-iron-session-security-production

# Supabase配置
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# CAS配置
CAS_MODE=real

# 启用示例用户登录功能 (生产环境可选)
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=true

# 数据库配置 (如果使用其他数据库)
# DATABASE_URL=your_database_url
